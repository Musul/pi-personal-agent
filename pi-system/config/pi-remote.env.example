# pi-remote.sh configuration template
#
# Copy this file to ~/.config/pi/remote.env (on the PC, not on the phone)
# and replace the placeholders:
#
#   cp pi-system/config/pi-remote.env.example ~/.config/pi/remote.env
#   chmod 600 ~/.config/pi/remote.env
#
# Or let the wrapper create it:
#
#   bash pi-system/scripts/pi-remote.sh setup \
#     --host <phone-ip> --user <termux-user> --key ~/.ssh/id_ed25519
#
# This file contains no secrets: only the phone address, SSH user, port and
# the path to the private key on this PC.

PI_TERMUX_HOST="192.0.2.10"   # replace with the phone LAN IP or Tailscale IP
PI_TERMUX_USER="u0_a123"      # replace with `whoami` in Termux
PI_TERMUX_PORT="8022"
PI_TERMUX_KEY="$HOME/.ssh/id_ed25519"
